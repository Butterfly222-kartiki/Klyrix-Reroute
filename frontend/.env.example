# ===== DISHA frontend (copy to frontend/.env) =====

# Map tile provider. Leave empty to use free OpenStreetMap tiles.
# Examples (replace the key):
#   Mapbox: https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/256/{z}/{x}/{y}@2x?access_token=YOUR_KEY
#   MapTiler: https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_MAP_TILE_URL=

# Optional: call a remote engine instead of the same-origin /api proxy (needs CORS; leave empty for the proxy)
# VITE_API_URL=
